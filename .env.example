# ─── Hetzner Cloud (gestión del firewall) ───
HETZNER_TOKEN=tu_token_de_hetzner_cloud
HETZNER_FIREWALL_ID=id_numerico_del_firewall

# ─── API interna agente <-> backend ───
# Genérala con: openssl rand -hex 32
# El agente (Windows) la exporta como NOCTUA_API_KEY con ESTE mismo valor
API_KEY=clave_api_interna_generada

# ─── Autenticación del dashboard Streamlit ───
AUTH_USERNAME=usuario_login_dashboard
AUTH_NAME=Nombre Mostrado
AUTH_PASSWORD=password_del_dashboard

# ─── Enriquecimiento de IPs (AbuseIPDB) ───
ABUSEIPDB_API_KEY=tu_api_key_de_abuseipdb
